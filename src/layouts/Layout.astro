---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Re\vibe Space - AI Room Makeover + Marketplace Products',
	description = 'Upload foto ruangan, dapatkan makeover AI, lalu temukan produk marketplace seperti Shopee-ready untuk checkout.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css" />
	</head>
	<body class="bg-paper text-ink antialiased">
		<slot />
		<script>
			import '../scripts/landing-interactions.js';
		</script>
	</body>
</html>
