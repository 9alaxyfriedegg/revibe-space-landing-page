---
const styles = [
  ["Minimal Modern", "Bersih, rapi, mudah dirawat.", "https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=700&q=80"],
  ["Japandi Cozy", "Kayu terang, warna tenang, tekstur lembut.", "https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&w=700&q=80"],
  ["Colorful Aesthetic", "Lebih berani, playful, tetap harmonis.", "https://images.unsplash.com/photo-1600210491369-e753d80a41f3?auto=format&fit=crop&w=700&q=80"],
  ["Soft Luxury", "Elegan tanpa terlihat berlebihan.", "https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=700&q=80"]
];
---

<section class="section-pad pt-8">
  <div class="container-shell flex flex-col lg:flex-row lg:gap-10 w-full">
    <div class="reveal lg:sticky lg:top-28 lg:self-start max-w-[720px]">
      <div class="eyebrow"><i class="ti ti-palette"></i>Pilihan style</div>
      <h2 class="typeset-title mt-6">
        Pilih vibe yang paling dekat dengan hidupmu.
      </h2>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {styles.map(([title, text, image]) => (
        <article class="reveal group overflow-hidden rounded-[22px] border border-black/10 bg-[#fffaf1]/74">
          <img class="h-64 w-full object-cover transition duration-500 group-hover:scale-105" src={image} alt={`Contoh style ${title}`} />
          <div class="p-5">
            <h3 class="typeset-card-title">{title}</h3>
            <p class="mt-2 text-sm leading-7 tracking-[-0.01em] text-[#675f56]">{text}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
