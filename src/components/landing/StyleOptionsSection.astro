---
import Reveal from '../motion/Reveal.astro';

const styles = [
	{
		title: 'Minimal Modern',
		copy: 'Bersih, rapi, dan mudah dirawat.',
		image: 'https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=720&q=80',
		alt: 'Kamar minimal modern',
	},
	{
		title: 'Japandi Cozy',
		copy: 'Kayu terang, warna tenang, dan tekstur lembut.',
		image: 'https://images.unsplash.com/photo-1618220179428-22790b461013?auto=format&fit=crop&w=720&q=80',
		alt: 'Interior japandi hangat',
	},
	{
		title: 'Colorful Aesthetic',
		copy: 'Lebih berani, playful, dan tetap harmonis.',
		image: 'https://images.unsplash.com/photo-1615873968403-89e068629265?auto=format&fit=crop&w=720&q=80',
		alt: 'Ruang colorful modern',
	},
	{
		title: 'Soft Luxury',
		copy: 'Elegan tanpa terlihat berlebihan.',
		image: 'https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?auto=format&fit=crop&w=720&q=80',
		alt: 'Interior luxury soft',
	},
];
---

<section class="px-4 py-18 sm:px-6 md:px-8 md:py-24 lg:px-18 xl:px-20" id="styles">
	<Reveal className="mb-10 max-w-4xl md:mb-14">
		<p class="mb-3.5 text-xs font-black uppercase tracking-[0.08em] text-coral">Pilihan style</p>
		<h2 class="text-[clamp(2rem,9vw,4.3rem)] font-black leading-none tracking-normal">
			Pilih vibe yang paling dekat dengan hidupmu.
		</h2>
	</Reveal>

	<div class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
		{styles.map((item, index) => (
			<Reveal delay={index * 0.08} className="grid gap-3">
				<img class="aspect-[4/5] w-full rounded-lg object-cover" src={item.image} alt={item.alt} />
				<h3 class="text-xl font-black leading-tight">{item.title}</h3>
				<p class="text-muted">{item.copy}</p>
			</Reveal>
		))}
	</div>
</section>
