---
const navItems = [
	{ href: '#problem', label: 'Kendala' },
	{ href: '#how-it-works', label: 'Cara Kerja' },
	{ href: '#marketplace', label: 'Produk' },
	{ href: '#pricing', label: 'Pricing' },
	{ href: '#faq', label: 'FAQ' },
];
---

<header
	class="fixed inset-x-0 top-0 z-50 flex justify-center items-center gap-4 px-4 py-3 md:px-8 lg:px-14"
	data-site-header
>
	<div class="max-w-screen-2xl w-full grid grid-cols-[1fr_auto] items-center gap-4 text-white transition-all duration-200 md:grid-cols-[auto_1fr_auto]">
		<a class="inline-flex items-center gap-2.5 whitespace-nowrap" href="#top" aria-label="Revibes">
			<span class="text-primary text-lg font-semibold">RE\VIBE SPACE</span>
		</a>
		<nav class="hidden justify-self-center md:flex md:gap-5 lg:gap-7" aria-label="Navigasi utama">
			{navItems.map((item) => <a class="text-sm text-gray-700 hover:text-primary" href={item.href}>{item.label}</a>)}
		</nav>
		<a
			class="inline-flex bg-primary rounded-full min-h-10 items-center justify-center border border-current px-4 text-sm"
			href="#final-cta"
		>
			Get Started
		</a>
	</div>
</header>

<script>
	const header = document.querySelector('[data-site-header]');
	const updateHeader = () => {
		header?.classList.toggle('bg-paper/95', window.scrollY > 24);
		header?.classList.toggle('text-ink', window.scrollY > 24);
		header?.classList.toggle('shadow-[0_10px_30px_rgba(23,23,23,0.08)]', window.scrollY > 24);
		header?.classList.toggle('backdrop-blur-xl', window.scrollY > 24);
	};

	window.addEventListener('scroll', updateHeader, { passive: true });
	updateHeader();
</script>
