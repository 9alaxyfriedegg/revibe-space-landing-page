---
import Reveal from '../motion/Reveal.astro';

const testimonials = [
	{
		quote: 'Biasanya aku cuma save inspo. Ini langsung kasih gambaran barang apa yang perlu dicari duluan.',
		name: 'Nadia',
		role: 'Penghuni kos',
		tone: 'warm',
	},
	{
		quote: 'Cocok buat desain awal coffee shop karena hasil visualnya kuat, dan arah belanjanya juga langsung jelas.',
		name: 'Raka',
		role: 'Coffee Shop Owner',
		tone: 'accent',
	},
	{
		quote: 'Yang paling ngebantu itu prioritas produknya. Jadi tahu mana yang wajib dibeli dulu, mana yang nanti.',
		name: 'Mira',
		role: 'Apartment studio',
		tone: 'soft',
	},
	{
		quote: 'Bukan cuma cantik di gambar, tapi lebih enak buat mutusin produk yang memang cocok sama ruangannya.',
		name: 'Dimas',
		role: 'Rumah keluarga',
		tone: 'neutral',
	},
];
---

<section class="section-pad" id="social-proof">
	<div class="container-shell">
		<Reveal className="max-w-[760px]">
			<div class="eyebrow">
				<i class="ti ti-message-heart"></i>
				Testimonial
			</div>
			<h2 class="mt-6 font-display text-[clamp(2rem,5vw,3.9rem)] font-black leading-[0.98] tracking-[-0.045em] text-charcoal">
				Pengalaman teman-teman setelah merasakan manfaat Re\vibe Space.
			</h2>
			<p class="mt-5 max-w-[60ch] text-[0.98rem] leading-7 tracking-[-0.01em] text-[color:var(--muted)] md:text-[1.05rem]">
				Dari anak kos sampai coffee shop owner, mereka suka karena prosesnya cepat, visualnya jelas, dan keputusan belanjanya jadi lebih ringan.
			</p>
		</Reveal>

		<div class="mt-12 grid gap-4 lg:grid-cols-[1.08fr_0.92fr]">
			<Reveal className="rounded-[22px] border border-charcoal/8 bg-charcoal p-6 text-paper shadow-[0_28px_80px_rgba(11,10,9,0.2)] md:p-8">
				<div class="flex items-center gap-2 text-saffron">
					<i class="ti ti-stars-filled text-lg"></i>
					<i class="ti ti-stars-filled text-lg"></i>
					<i class="ti ti-stars-filled text-lg"></i>
					<i class="ti ti-stars-filled text-lg"></i>
					<i class="ti ti-stars-filled text-lg"></i>
				</div>
				<p class="mt-8 max-w-[24ch] font-display text-[clamp(1.7rem,3.5vw,2.8rem)] font-black leading-[1] tracking-[-0.04em]">
					Orang tidak cuma cari inspo. Mereka ingin tahu apa yang harus dibeli, seberapa penting barang itu, dan bagaimana hasil akhirnya nanti.
				</p>
				<p class="mt-5 max-w-[54ch] text-[0.92rem] leading-7 tracking-[-0.01em] text-[#d7cdbf] md:text-[0.98rem]">
					Testimoni ini menunjukkan hal yang sama: visual makeover memang menarik, tapi nilai utamanya muncul saat orang bisa langsung membayangkan produk, prioritas, dan hasil akhirnya di ruang mereka sendiri.
				</p>
			</Reveal>

			<div class="grid gap-4 sm:grid-cols-2">
				{testimonials.map(({ quote, name, role, tone }, index) => (
					<Reveal delay={index * 0.08}>
						<article
							class:list={[
								'flex h-full flex-col rounded-[22px] border p-5 shadow-[0_18px_48px_rgba(66,43,26,0.08)] transition-transform duration-300 hover:-translate-y-1 md:p-6',
								tone === 'warm' && 'border-clay/14 bg-[#f2e4d8] text-charcoal',
								tone === 'accent' && 'border-saffron/40 bg-saffron text-[color:var(--accent-ink)]',
								tone === 'soft' && 'border-stone/60 bg-paper text-charcoal',
								tone === 'neutral' && 'border-fern/12 bg-milk text-charcoal',
							]}
						>
							<div class="flex items-center justify-between">
								<div class="flex items-center gap-1 text-coral">
									<i class="ti ti-star-filled text-sm"></i>
									<i class="ti ti-star-filled text-sm"></i>
									<i class="ti ti-star-filled text-sm"></i>
									<i class="ti ti-star-filled text-sm"></i>
									<i class="ti ti-star-filled text-sm"></i>
								</div>
								<div
									class:list={[
										'flex h-11 w-11 items-center justify-center rounded-full font-display text-sm font-black uppercase',
										tone === 'accent' ? 'bg-[color:var(--accent-ink)] text-saffron' : 'bg-charcoal text-paper',
									]}
								>
									{name.charAt(0)}
								</div>
							</div>

							<p class="mt-5 text-[0.92rem] leading-7 tracking-[-0.01em] md:text-[0.96rem]">
								"{quote}"
							</p>

							<div class="mt-auto pt-8">
								<p class="text-[0.95rem] font-bold leading-tight">{name}</p>
								<p class="mt-1 text-[0.82rem] opacity-70">{role}</p>
							</div>
						</article>
					</Reveal>
				))}
			</div>
		</div>
	</div>
</section>
