---
import Reveal from '../motion/Reveal.astro';

const testimonials = [
	['“Biasanya aku cuma save inspo. Ini langsung tahu barang apa yang harus dicari.”', 'Nadia, penghuni kos'],
	['“Cocok buat campaign dekor rumah karena hasilnya visual dan CTA belanjanya jelas.”', 'Raka, marketplace seller'],
	['“Yang paling ngebantu: rekomendasi produk bisa diurutkan dari yang wajib dulu.”', 'Mira, apartemen studio'],
];
---

<section class="bg-soft px-4 py-18 sm:px-6 md:px-8 md:py-24 lg:px-18 xl:px-20">
	<Reveal className="mb-10 max-w-4xl md:mb-14">
		<p class="mb-3.5 text-xs font-black uppercase tracking-[0.08em] text-coral">Cerita user</p>
		<h2 class="text-[clamp(2rem,9vw,4.3rem)] font-black leading-none tracking-normal">
			Validasi cepat untuk user yang butuh arahan.
		</h2>
	</Reveal>

	<div class="grid gap-4 lg:grid-cols-3">
		{testimonials.map(([quote, name], index) => (
			<Reveal delay={index * 0.08} className="min-h-56 rounded-lg border border-line bg-white p-6">
				<p class="text-lg leading-relaxed text-muted">{quote}</p>
				<strong class="mt-6 block text-mint-dark">{name}</strong>
			</Reveal>
		))}
	</div>
</section>
