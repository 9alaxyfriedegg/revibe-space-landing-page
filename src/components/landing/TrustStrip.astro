---
const items = [
  ["Belanja Langsung", "Hasil redesign terhubung ke produk yang bisa dicari dan dibeli."],
  ["Produk Nyata", "Rekomendasi dibuat dari katalog brand dan marketplace, bukan dekor fiktif."],
  ["Vibe Fleksibel", "Minimal modern, japandi cozy, colorful aesthetic, atau soft luxury."],
  ["Ruang Harian", "Cocok untuk kamar kos, apartemen kecil, ruang keluarga, dan workspace."]
];
---

<section class="pb-8">
  <div class="border-y border-black/10 py-5">
    <div class="container-shell grid gap-3 md:grid-cols-4">
		{items.map(([title, body]) => (
		  <div class="reveal px-1">
			<p class="typeset-kicker text-ink">{title}</p>
			<p class="mt-2 max-w-[28ch] text-[0.96rem] leading-7 tracking-[-0.01em] text-[#675f56]">{body}</p>
		  </div>
		))}
	  </div>
	</div>
</section>
