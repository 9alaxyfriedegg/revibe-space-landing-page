---
const steps = [
  ["Upload Foto Ruangan", "Ambil foto dari sudut paling jelas. Foto biasa dari HP sudah cukup untuk memulai."],
  ["Pilih Style", "Tentukan vibe, jenis ruang, dan kisaran harga supaya rekomendasi tetap realistis."],
  ["AI Take Action", "AI membuat beberapa opsi tampilan yang masih terasa seperti ruangmu sendiri."],
  ["Checkout Produk", "Buka daftar barang prioritas, match score, estimasi harga, dan link marketplace."]
];
---

<section id="cara-kerja" class="section-pad">
  <div class="container-shell grid gap-10 lg:grid-cols-[0.88fr_1.12fr]">
    <div class="reveal lg:sticky lg:top-28 lg:self-start">
      <div class="eyebrow"><i class="ti ti-route"></i>Proses Transformasi</div>
      <h2 class="typeset-title mt-6">
        Empat langkah yang terasa ringan.
      </h2>
      <p class="typeset-lead mt-6">
        Flow dibuat untuk orang yang ingin ruangnya naik level tanpa harus jadi interior designer dulu.
      </p>
    </div>
    <div class="space-y-4">
      {steps.map(([title, body], index) => (
        <article class="reveal grid gap-5 rounded-[22px] border border-black/10 bg-[#fffaf1]/70 p-5 md:grid-cols-[120px_1fr]">
          <div class="flex h-24 items-center justify-center rounded-[18px] bg-[#ffb22c] text-4xl font-black text-[#261600]">0{index + 1}</div>
          <div class="flex flex-col justify-center">
            <h3 class="typeset-card-title">{title}</h3>
            <p class="typeset-body mt-2 max-w-[56ch]">{body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
