---
import Reveal from '../motion/Reveal.astro';

const steps = [
	['Upload foto ruangan', 'Ambil foto dari sudut paling jelas. Cocok untuk kamar pribadi, kos, apartemen, atau ruang keluarga.'],
	['Pilih style dan budget', 'Tentukan vibe aesthetic, japandi, minimal, colorful, atau luxury. Budget membantu rekomendasi tetap realistis.'],
	['Generate makeover', 'AI membuat beberapa opsi tampilan yang mempertahankan karakter ruangan asli.'],
	['Checkout produk', 'Lihat listing produk yang mirip dengan hasil desain dan buka marketplace pilihanmu.'],
];
---

<section class="bg-charcoal px-4 py-18 text-white sm:px-6 md:px-8 md:py-24 lg:px-18 xl:px-20" id="how-it-works">
	<Reveal className="mb-10 max-w-4xl md:mb-14">
		<p class="mb-3.5 text-xs font-black uppercase tracking-[0.08em] text-[#ffbf9f]">Cara kerja</p>
		<h2 class="text-[clamp(2rem,9vw,4.3rem)] font-black leading-none tracking-normal">
			Dari foto ruangan ke checkout produk.
		</h2>
	</Reveal>

	<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
		{steps.map(([title, copy], index) => (
			<Reveal delay={index * 0.08} className="min-h-70 rounded-lg border border-white/15 p-6">
				<span class="mb-11 grid size-11 place-items-center rounded-lg bg-mint font-black text-white">
					{String(index + 1).padStart(2, '0')}
				</span>
				<h3 class="text-xl font-black leading-tight">{title}</h3>
				<p class="mt-4 leading-relaxed text-white/70">{copy}</p>
			</Reveal>
		))}
	</div>
</section>
