---
const faqs = [
  ["Apakah harus punya ruangan yang sudah rapi?", "Tidak. Foto biasa tetap bisa dipakai, selama sudut ruangan terlihat cukup jelas."],
  ["Apakah produk bisa langsung checkout di Shopee?", "Konsepnya marketplace-ready. Link dapat diarahkan ke Shopee, Tokopedia, atau partner lain sesuai integrasi produk."],
  ["Kalau budget kecil, apakah tetap bisa?", "Bisa. Budget dipakai untuk memilih item prioritas dan alternatif produk yang lebih masuk akal."],
  ["Apakah ini cocok untuk seller dekorasi?", "Cocok untuk seller yang ingin produknya muncul dalam konteks ruangan nyata, bukan hanya katalog produk biasa."]
];
---

<section id="faq" class="section-pad pt-8">
  <div class="container-shell grid gap-10 lg:grid-cols-[0.75fr_1.25fr]">
    <div class="reveal">
      <div class="eyebrow"><i class="ti ti-help"></i>FAQ</div>
      <h2 class="typeset-title mt-6 max-w-[10ch]">
        Pertanyaan sebelum coba.
      </h2>
      <p class="typeset-body mt-6 max-w-[40ch]">
        Jawaban singkat, tanpa klaim berlebihan. Fokusnya tetap di hal yang biasanya bikin orang ragu sebelum mulai.
      </p>
    </div>
    <div class="reveal divide-y divide-black/10 rounded-[22px] border border-black/10 bg-[#fffaf1]/76">
      {faqs.map(([question, answer]) => (
        <details class="group p-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-[1.28rem] font-black leading-[1.2] tracking-[-0.03em] text-charcoal">
            {question}
            <i class="ti ti-plus transition group-open:rotate-45"></i>
          </summary>
          <p class="mt-4 max-w-[62ch] text-[0.98rem] leading-7 tracking-[-0.01em] text-[#675f56]">{answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
