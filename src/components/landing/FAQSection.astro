---
import Reveal from '../motion/Reveal.astro';

const faqs = [
	['Apakah harus punya ruangan yang sudah rapi?', 'Tidak. Foto biasa tetap bisa dipakai, selama sudut ruangan terlihat cukup jelas.'],
	['Apakah produk bisa langsung checkout di Shopee?', 'Konsepnya marketplace-ready. Link dapat diarahkan ke Shopee, Tokopedia, atau partner lain sesuai integrasi produk.'],
	['Kalau budget kecil, apakah tetap bisa?', 'Bisa. Budget dipakai untuk memilih item prioritas dan alternatif produk yang lebih masuk akal.'],
	['Apakah ini cocok untuk seller dekorasi?', 'Cocok untuk seller yang ingin produknya muncul dalam konteks ruangan nyata, bukan hanya katalog produk biasa.'],
];
---

<section class="px-4 py-18 sm:px-6 md:px-8 md:py-24 lg:px-18 xl:px-20" id="faq">
	<Reveal className="mb-10 max-w-4xl md:mb-14">
		<p class="mb-3.5 text-xs font-black uppercase tracking-[0.08em] text-coral">FAQ</p>
		<h2 class="text-[clamp(2rem,9vw,4.3rem)] font-black leading-none tracking-normal">
			Pertanyaan yang biasanya muncul sebelum coba.
		</h2>
	</Reveal>

	<div class="grid gap-3">
		{faqs.map(([question, answer], index) => (
			<Reveal delay={index * 0.05}>
				<details class="rounded-lg border border-line bg-white p-5" open={index === 0}>
					<summary class="cursor-pointer font-black">{question}</summary>
					<p class="mt-4 leading-relaxed text-muted">{answer}</p>
				</details>
			</Reveal>
		))}
	</div>
</section>
