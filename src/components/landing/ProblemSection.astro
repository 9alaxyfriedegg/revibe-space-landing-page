---
import Reveal from '../motion/Reveal.astro';

const problems = [
	{
		title: 'Inspirasi terlalu banyak',
		copy: 'Pinterest dan TikTok penuh ide, tapi sulit tahu mana yang cocok untuk ukuran dan kondisi ruangan sendiri.',
	},
	{
		title: 'Produknya susah dicari',
		copy: 'Sudah suka satu style, lalu habis waktu cari sofa, lampu, karpet, meja, dan dekorasi yang mirip.',
	},
	{
		title: 'Takut salah beli',
		copy: 'Warna, ukuran, dan vibe bisa meleset. Akhirnya keranjang penuh, tapi checkout ditunda terus.',
	},
];
---

<section class="px-4 py-18 sm:px-6 md:px-8 md:py-24 lg:px-18 xl:px-20" id="problem">
	<Reveal className="mb-10 max-w-4xl md:mb-14">
		<p class="mb-3.5 text-xs font-black uppercase tracking-[0.08em] text-coral">Problem</p>
		<h2 class="text-[clamp(2rem,9vw,4.3rem)] font-black leading-none tracking-normal">
			Pengen ruangan bagus, tapi bingung mulai dari mana.
		</h2>
	</Reveal>

	<div class="grid gap-4 lg:grid-cols-3">
		{problems.map((problem, index) => (
			<Reveal delay={index * 0.08} className="min-h-64 rounded-lg border border-line bg-white p-6">
				<span class="mb-10 grid size-11 place-items-center rounded-lg bg-soft font-black text-mint-dark">
					{String(index + 1).padStart(2, '0')}
				</span>
				<h3 class="text-xl font-black leading-tight">{problem.title}</h3>
				<p class="mt-4 leading-relaxed text-muted">{problem.copy}</p>
			</Reveal>
		))}
	</div>
</section>
