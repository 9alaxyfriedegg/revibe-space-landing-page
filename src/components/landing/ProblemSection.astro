---
import Reveal from '../motion/Reveal.astro';

const problems = [
	{
		title: 'Inspirasi terlalu banyak',
		icon: 'ti-bulb',
		image: '/images/problem-1.jpg',
		copy: 'Pinterest dan TikTok penuh ide, tapi sulit tahu mana yang benar-benar cocok untuk ukuran, layout, dan kebutuhan ruangmu sendiri. Semakin banyak referensi yang dilihat, semakin mudah overthinking dan bingung menentukan titik mulai.',
	},
	{
		title: 'Produknya susah dicari',
		icon: 'ti-search',
		image: '/images/problem-2.jpeg',
		copy: 'Sudah suka satu style, tapi mencari sofa, lampu, karpet, meja, dan dekor yang matching sering makan waktu. Belum tentu produk yang ditemukan punya warna, ukuran, atau harga yang sesuai dengan ekspektasi.',
	},
	{
		title: 'Takut salah beli',
		icon: 'ti-shopping-cart',
		image: '/images/problem-3.jpeg',
		copy: 'Warna, ukuran, dan vibe bisa meleset saat produk datang, apalagi kalau beli tanpa visualisasi yang jelas. Akhirnya banyak barang cuma masuk keranjang, wishlist, atau checkout terus ditunda karena masih ragu.',
	},
];
---

<section class="section-pad mx-auto flex w-full justify-center" id="problem">
	<div class="container-shell">
		<Reveal className="mb-10 flex w-full flex-col justify-between gap-8 md:mb-14 lg:flex-row">
			<div class="title w-full lg:max-w-2/3">
				<p class="eyebrow">
					<i class="ti ti-alert-triangle"></i> Kami tahu masalahmu!
				</p>
				<h2 class="typeset-title font-black mt-6 max-w-[12ch] text-charcoal">
					Pengen ruangan <span class="text-coral italic">aesthetic</span>, tapi bingung mulai dari mana.
				</h2>
			</div>
			<p class="hidden max-w-[70ch] self-end text-[0.95rem] leading-7 tracking-[-0.01em] text-[color:var(--muted)] md:block">
				Banyak orang tahu ruang seperti apa yang mereka inginkan, tapi bingung bagaimana memulainya. Inspirasi tersebar di Pinterest, TikTok, dan berbagai marketplace, namun sulit menentukan mana yang benar-benar cocok untuk ukuran, layout, dan gaya ruang sendiri. Setelah menemukan style yang disukai, proses mencari produk yang matching pun sering terasa melelahkan. Belum lagi kekhawatiran salah beli yang membuat keputusan akhirnya terus tertunda.
			</p>
		</Reveal>

		<Reveal className="mb-10 rounded-4xl border border-white/8 bg-[#22211f] p-4 shadow-[0_26px_80px_rgba(10,10,9,0.32)] md:p-8 lg:mb-14">
			<div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-8">
				<div class="col-span-2 flex flex-col gap-4 lg:col-span-1">
					{problems.map((problem, index) => (
						<div
							class={`problem-card flex cursor-pointer flex-row items-start gap-3 rounded-xl border border-white/8 bg-white/4 p-4 transition-all duration-300 md:gap-4 md:rounded-2xl md:p-5 hover:border-clay/30 hover:bg-linear-to-br hover:from-[#352822] hover:to-[#2a2724] hover:shadow-[0_18px_50px_rgba(0,0,0,0.28)] ${index === 0 ? 'border-clay/30 bg-linear-to-br from-[#3a2b24] to-[#2b2824] shadow-[0_18px_50px_rgba(0,0,0,0.28)]' : '' }`}
							data-problem-index={index}
						>
							<img src={problem.image} alt={problem.title} class="block h-16 w-16 rounded-lg object-cover lg:hidden md:h-20 md:w-20" />
							<div class="hidden h-fit min-w-fit flex-shrink-0 items-center justify-center rounded-lg bg-clay/80 p-2 text-lg text-milk lg:flex md:text-2xl">
								<i class={`ti ${problem.icon}`}></i>
							</div>
							<div class="flex-1">
								<h3 class="mb-2 font-display text-[1rem] font-black leading-tight tracking-[-0.025em] text-paper md:text-[1.2rem]">{problem.title}</h3>
								<p class="text-[0.9rem] leading-6 tracking-[-0.01em] text-stone/88 md:text-[0.95rem] md:leading-7">{problem.copy}</p>
							</div>
						</div>
					))}
				</div>
				<div class="relative hidden h-48 w-full items-center justify-center overflow-hidden rounded-2xl border border-white/8 bg-[#2a2724] p-4 lg:flex md:h-80 md:p-8 lg:h-full">
					{problems.map((problem, index) => (
						<img
							src={problem.image}
							class={`problem-image problem-image-${index} absolute inset-0 h-full w-full rounded-2xl object-cover transition-opacity duration-300 ${index === 0 ? 'opacity-100' : 'opacity-0 pointer-events-none'}`}
							alt={problem.title}
						/>
					))}
				</div>
			</div>
		</Reveal>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const problemCards = document.querySelectorAll('.problem-card');
		
		problemCards.forEach(card => {
			card.addEventListener('mouseenter', () => {
				const index = card.getAttribute('data-problem-index');
				document.querySelectorAll('.problem-card').forEach(c => {
					c.classList.remove('border-clay/30', 'bg-linear-to-br', 'from-[#3a2b24]', 'to-[#2b2824]', 'shadow-[0_18px_50px_rgba(0,0,0,0.28)]');
				});

				// Hide all images
				document.querySelectorAll('.problem-image').forEach(img => {
					img.classList.remove('opacity-100');
					img.classList.add('opacity-0', 'pointer-events-none');
				});
				
				// Show the corresponding image
				const activeImage = document.querySelector(`.problem-image-${index}`);
				if (activeImage) {
					card.classList.add('border-clay/30', 'bg-linear-to-br', 'from-[#3a2b24]', 'to-[#2b2824]', 'shadow-[0_18px_50px_rgba(0,0,0,0.28)]');
					activeImage.classList.remove('opacity-0', 'pointer-events-none');
					activeImage.classList.add('opacity-100');
				}
			});
		});
	});
</script>
	</div>
</section>
