---
import Reveal from '../motion/Reveal.astro';
---

<section class="grid items-end gap-8 bg-mint-dark px-4 py-18 text-white sm:px-6 md:px-8 md:py-24 lg:grid-cols-[1fr_0.78fr] lg:px-18 xl:px-20" id="final-cta">
	<Reveal>
		<p class="mb-3.5 text-xs font-black uppercase tracking-[0.08em] text-[#ffd0bd]">Akses beta</p>
		<h2 class="text-[clamp(2rem,9vw,4.3rem)] font-black leading-none tracking-normal">
			Upload ruanganmu. Lihat desainnya. Checkout barangnya.
		</h2>
		<p class="mt-6 max-w-3xl text-lg leading-relaxed text-white/75">
			Masuk daftar beta untuk mencoba Roomly AI saat akses awal dibuka untuk user Indonesia
			dan partner marketplace.
		</p>
	</Reveal>

	<Reveal delay={0.12}>
		<form class="grid gap-2.5" data-signup-form>
			<label class="font-black" for="email">Email kamu</label>
			<div class="grid gap-2.5 sm:grid-cols-[1fr_auto]">
				<input
					class="min-h-13 min-w-0 rounded-lg border border-white/25 bg-white/10 px-3.5 text-white outline-none placeholder:text-white/60 focus:border-white"
					id="email"
					type="email"
					placeholder="nama@email.com"
					required
				/>
				<button class="min-h-13 rounded-lg bg-coral px-6 font-black text-white" type="submit">
					Daftar Beta
				</button>
			</div>
			<p class="text-sm text-white/75" data-form-note>Early access untuk user, seller, dan partner marketplace.</p>
		</form>
	</Reveal>
</section>

<script>
	const form = document.querySelector('[data-signup-form]');
	const note = document.querySelector('[data-form-note]');

	form?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (note) note.textContent = 'Siap. Kamu masuk daftar beta Roomly AI.';
		form.reset();
	});
</script>
