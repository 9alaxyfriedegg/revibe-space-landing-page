<section id="beta" class="section-pad pt-8">
  <div class="container-shell">
    <div class="reveal overflow-hidden rounded-[28px] bg-[#22211f] text-paper soft-shadow">
      <div class="grid gap-8 p-6 md:p-10 lg:grid-cols-[1fr_0.9fr] lg:p-14">
        <div>
          <div class="eyebrow border-white/14 bg-white/8 text-[#ffdda0]"><i class="ti ti-rocket"></i>Beta Access</div>
          <h2 class="typeset-title mt-6 max-w-[10ch] text-paper">
            Upload ruanganmu. Lihat desainnya. Checkout barangnya.
          </h2>
          <p class="typeset-lead mt-6 text-[#d7cdbf]">
            Masuk daftar beta untuk mencoba <b>Re\vibe Space</b> saat akses awal dibuka untuk user Indonesia, seller, dan partner marketplace.
          </p>
        </div>
        <form class="self-end rounded-[22px] border border-white/10 bg-white/8 p-4" data-beta-form>
          <label for="email" class="text-sm font-black text-[#ffdda0]">Email kamu</label>
          <div class="mt-3 flex flex-col gap-3 sm:flex-row">
            <input id="email" name="email" type="email" required placeholder="nama@email.com" class="min-h-14 flex-1 rounded-full border border-white/14 bg-white px-5 font-bold text-ink placeholder:text-[#7b736b]" />
            <button class="btn btn-primary whitespace-nowrap" type="submit">Daftar Beta</button>
          </div>
          <p class="mt-4 text-sm leading-6 tracking-[-0.01em] text-[#d7cdbf]" data-form-status>Early access untuk user, seller, dan partner marketplace.</p>
        </form>
      </div>
    </div>
  </div>
</section>
