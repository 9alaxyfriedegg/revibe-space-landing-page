---
import Reveal from '../motion/Reveal.astro';
import ComparisonSlider from '../motion/ComparisonSlider.astro';
---

<section class="container-shell flex min-h-[100dvh] flex-col justify-center gap-8 py-20 md:gap-12 md:py-20" id="top">
	<div class="relative isolate lg:px-8">
		<div aria-hidden="true" class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80">
			<div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)" class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-clay to-saffron opacity-30 sm:left-[calc(50%-30rem)] sm:w-288.75"></div>
		</div>
		<div aria-hidden="true" class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[calc(100%-30rem)]">
			<div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)" class="relative left-[calc(50%+3rem)] aspect-1155/678 w-144.5 -translate-x-1/2 bg-linear-to-tr from-coral to-saffron opacity-30 sm:left-[calc(50%+36rem)] sm:w-288.75"></div>
		</div>
	</div>
	
	<div class="relative flex flex-col lg:flex-row lg:gap-15 max-w-screen-2xl mx-auto w-full">
		<!-- Content Section -->
		<div class="w-full lg:max-w-[50%]">
			<!-- Notification Badge -->
			<Reveal>
				<div class="mb-6 md:mb-8">
					<span class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-milk/80 px-3 sm:px-4 py-2 text-ink text-xs sm:text-sm font-light shadow-[0_16px_40px_rgba(133,72,54,0.08)]">
						<i class="ti ti-sparkles text-lg sm:text-xl"></i>
						AI Room Redesign + Shoppable Products
					</span>
				</div>
			</Reveal>

			<!-- Main Headline -->
			<Reveal delay={0.1}>
				<h1 class="max-w-[11ch] font-display text-[clamp(2.5rem,5vw,3.6rem)] font-black leading-[0.96] tracking-[-0.05em] text-ink">
					Buat ruanganmu sesuai dengan <i class="text-coral">vibe</i> yang kamu mau, tanpa ribet!
				</h1>
			</Reveal>

			<!-- Description -->
			<Reveal delay={0.2}>
				<p class="mt-4 max-w-[34rem] text-[0.98rem] leading-7 tracking-[-0.01em] text-[color:var(--muted)] sm:mt-6 md:text-[1.05rem] md:leading-8">
					Upload foto ruanganmu dan biarkan AI mengubahnya jadi ruang <i>aesthetic</i> dengan produk pilihan yang bisa langsung kamu beli.
				</p>
			</Reveal>

			<!-- CTA Buttons -->
			<Reveal delay={0.3}>
				<div class="mt-8 sm:mt-10 flex flex-col gap-3 sm:gap-4 sm:flex-row">
					<a
						href="#final-cta"
						class="inline-flex items-center justify-center rounded-full bg-saffron px-6 sm:px-8 py-2.5 sm:py-3 text-sm sm:text-base font-medium text-[color:var(--accent-ink)] shadow-[0_18px_46px_rgba(255,178,44,0.24)] transition hover:bg-coral hover:text-white hover:-translate-y-0.5 active:translate-y-0"
					>
						<i class="ti ti-sparkles mr-1 sm:mr-2"></i>
						Coba Gratis
					</a>
					<a
						href="#solusi"
						class="inline-flex items-center justify-center rounded-full border-2 border-stone px-6 sm:px-8 py-2.5 sm:py-3 text-sm sm:text-base font-medium text-ink transition hover:border-clay hover:bg-milk hover:-translate-y-0.5 active:translate-y-0"
					>
						<i class="ti ti-player-play mr-1.5 sm:mr-2"></i>
						Lihat Caranya
					</a>
				</div>
			</Reveal>
		</div>

		<!-- Before/After Comparison Section -->
		<div class="w-full lg:max-w-[50%] flex items-center mt-8 md:mt-12 lg:mt-0 pb-8 md:pb-12">
			<div class="relative w-full">
				<!-- Floating Card - Top Left (Hidden on Mobile & Tablet) -->
				<Reveal delay={0.8} className="hidden xl:flex absolute z-10 -top-10 -left-10 bg-white/30 backdrop-blur-sm rounded-3xl p-4 shadow-lg">
					<img src="/images/architect-lamp.png" class="w-24 h-24 bg-white/70 rounded-xl p-2 object-cover object-top mr-3" />
					<div class="flex flex-col justify-center">
						<span class="text-ink text-xs font-light">Real Product</span>
						<span class="font-bold text-ink text-sm">Architect Lamp</span>
						<span class="text-xs text-[color:var(--muted)]">Rp 199.000</span>
						<span class="mt-1 w-full rounded-full bg-fern py-1 px-2 text-center text-[8px] text-milk">
							<i class="ti ti-shopping-cart"></i>
							Buy Now
						</span>
					</div>
				</Reveal>

				<!-- Comparison Slider -->
				<Reveal delay={0.6} className="w-full rounded-xl sm:rounded-2xl overflow-hidden shadow-lg md:shadow-2xl">
					<ComparisonSlider
						beforeImage="https://images.unsplash.com/photo-1517457373614-b7152f800fd1?auto=format&fit=crop&w=1200&q=82"
						afterImage="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=1200&q=82"
						beforeLabel="BEFORE"
						afterLabel="AFTER AI UPGRADE"
					/>
				</Reveal>

				<!-- Floating Card - Bottom Right (Hidden on Mobile, Visible on Tablet+) -->
				<Reveal delay={0.7} className="hidden md:flex absolute z-10 -bottom-6 -right-3 lg:-bottom-10 lg:-right-8 flex-col items-center gap-2 md:gap-3 lg:gap-4 rounded-2xl md:rounded-2xl lg:rounded-3xl border border-ink/8 bg-milk/70 p-2.5 md:p-3 lg:p-4 shadow-[0_22px_50px_rgba(133,72,54,0.14)] backdrop-blur-sm">
					<div class="flex items-center gap-1.5 md:gap-2">
						<i class="ti ti-palette text-xl md:text-3xl lg:text-4xl text-coral"></i>
						<div class="flex flex-col">
							<span class="text-ink text-xs font-medium">Palette Generated</span>
							<span class="font-bold text-ink text-xs md:text-sm">Warm Minimalist</span>
						</div>
					</div>
					<div class="flex items-center justify-between gap-1.5 md:gap-2">
						<div class="size-5 md:size-6 lg:size-8 rounded-lg md:rounded-lg lg:rounded-xl bg-paper"></div>
						<div class="size-5 md:size-6 lg:size-8 rounded-lg md:rounded-lg lg:rounded-xl bg-saffron"></div>
						<div class="size-5 md:size-6 lg:size-8 rounded-lg md:rounded-lg lg:rounded-xl bg-clay"></div>
						<div class="size-5 md:size-6 lg:size-8 rounded-lg md:rounded-lg lg:rounded-xl bg-charcoal"></div>
					</div>
				</Reveal>
			</div>
		</div>
	</div>
</section>
