---
import Reveal from '../motion/Reveal.astro';
import ComparisonSlider from '../motion/ComparisonSlider.astro';
---

<section class="relative min-h-screen bg-neutral px-4 pb-16 pt-32 sm:px-6 md:px-8 lg:px-12">
	<div class="mx-auto max-w-screen-xl text-center">
		<!-- Notification Badge -->
		<Reveal>
			<div class="mb-8 flex justify-center">
				<span class="inline-flex items-center gap-2 rounded-full border border-green-200 bg-green-100 animate-pulse px-4 py-2 text-green-900 text-sm font-semibold text-gray-700">
					<i class="ti ti-sparkles text-2xl"></i>
					AI Room Redesign + Shoppable Products
				</span>
			</div>
		</Reveal>

		<!-- Main Headline -->
		<Reveal delay={0.1}>
			<h1 class="text-4xl font-black leading-tight tracking-tight text-gray-900 sm:text-5xl md:text-6xl">
				Buat ruanganmu sesuai dengan <i class="text-primary">vibe</i> yang kamu mau, tanpa ribet!
			</h1>
		</Reveal>

		<!-- Description -->
		<Reveal delay={0.2}>
			<p class="mx-auto mt-6 max-w-2xl text-lg text-gray-600">
				Upload foto ruanganmu dan biarkan AI mengubahnya jadi ruang <i>aesthetic</i> dengan produk pilihan yang bisa langsung kamu beli.
			</p>
		</Reveal>

		<!-- CTA Buttons -->
		<Reveal delay={0.3}>
			<div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
				<a
					href="#final-cta"
					class="inline-flex items-center justify-center rounded-full bg-primary px-8 py-3 text-white transition hover:bg-amber-900 hover:-translate-y-0.5"
				>
					<i class="ti ti-sparkles mr-1"></i>
					Coba Gratis
				</a>
				<a
					href="#solution"
					class="inline-flex items-center justify-center rounded-full border-2 border-gray-300 px-8 py-3 text-gray-900 transition hover:border-gray-400 hover:-translate-y-0.5"
				>
					<i class="ti ti-player-play mr-2"></i>
					Lihat Caranya
				</a>
			</div>
		</Reveal>
	</div>

	<!-- Before/After Comparison Section -->
	<div class="mt-16 mb-32 w-full mx-auto">
		<div class="relative max-w-screen-xl mx-auto">
			<Reveal delay={0.8} className="absolute z-10 -top-40 -left-30 bg-white/30 backdrop-blur-sm rounded-4xl p-8 shadow-lg">
				<img src="/images/architect-lamp.png" class="w-40 bg-[#E5D3B3] rounded-2xl p-8 object-cover" />
				<div class="flex flex-col mt-5">
					<span class="text-slate-900">Real Product</span>
					<span class="text-xl font-semibold text-slate-900">Architect Lamp</span>
				</div>
			</Reveal>
			<Reveal delay={0.6} className="w-full max-w-screen-xl rounded-2xl overflow-hidden shadow-2xl">
				<ComparisonSlider
					beforeImage="https://images.unsplash.com/photo-1517457373614-b7152f800fd1?auto=format&fit=crop&w=1200&q=82"
					afterImage="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=1200&q=82"
					beforeLabel="BEFORE"
					afterLabel="AFTER AI UPGRADE"
				/>
			</Reveal>
			<Reveal delay={1} className="absolute z-10 -bottom-10 -right-30 flex flex-col items-center gap-4 bg-white/30 backdrop-blur-sm rounded-4xl p-8 shadow-lg">
				<div class="flex item-center gap-2">
					<i class="ti ti-palette text-5xl"></i>
					<div class="flex flex-col">
						<span class="text-slate-900">Palette Generated</span>
						<span class="text-xl font-semibold text-slate-900">Warm Minimalist</span>
					</div>
				</div>
				<div class="flex items-center justify-between gap-2">
					<div class="size-10 rounded-xl bg-[#E5D3B3]"></div>
					<div class="size-10 rounded-xl bg-[#BC9F77]"></div>
					<div class="size-10 rounded-xl bg-[#D1D1CE]"></div>	
					<div class="size-10 rounded-xl bg-[#2C2C2C]"></div>	
				</div>
			</Reveal>
		</div>
	</div>
</section>
