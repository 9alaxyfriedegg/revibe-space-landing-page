---
import Reveal from '../motion/Reveal.astro';
---

<section class="relative grid min-h-[94vh] items-end gap-8 overflow-hidden px-4 pb-9 pt-24 text-white sm:px-6 md:grid-cols-[1fr_380px] md:px-8 md:pb-14 lg:px-18 xl:px-20">
	<img
		class="absolute inset-0 h-full w-full object-cover"
		src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1800&q=82"
		alt="Ruang keluarga modern yang tertata rapi"
	/>
	<div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(0,0,0,0.78),rgba(0,0,0,0.35)_58%,rgba(0,0,0,0.2)),linear-gradient(0deg,rgba(0,0,0,0.52),transparent_55%)]"></div>

	<Reveal className="relative max-w-[820px]">
		<p class="mb-3.5 text-xs font-black uppercase tracking-[0.08em] text-[#ffbf9f]">
			AI room makeover + produk marketplace
		</p>
		<h1 class="max-w-[12ch] text-[clamp(3rem,17vw,4.55rem)] font-black leading-[0.94] tracking-normal md:text-[clamp(4rem,9vw,7.2rem)]">
			Kamar aesthetic, produk belinya langsung ketemu.
		</h1>
		<p class="mt-6 max-w-2xl text-base leading-relaxed text-white/88 sm:text-lg">
			Upload foto kamar, kos, ruang tamu, atau studio. AI membuat makeover visual yang realistis,
			lalu menampilkan daftar produk marketplace yang cocok untuk langsung kamu checkout.
		</p>
		<div class="mt-8 flex flex-wrap gap-3">
			<a class="inline-flex min-h-13 items-center justify-center rounded-lg bg-coral px-6 font-black text-white transition hover:-translate-y-0.5" href="#final-cta">
				Join Waitlist
			</a>
			<a class="inline-flex min-h-13 items-center justify-center rounded-lg border border-white/50 bg-white/15 px-6 font-black text-white transition hover:-translate-y-0.5" href="#solution">
				Lihat Cara Kerja
			</a>
		</div>
		<div class="mt-8 grid gap-3 sm:flex sm:flex-wrap">
			<span class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-white/30 bg-black/15 px-3.5 text-white/90">
				<strong class="text-white">1 foto</strong> jadi desain
			</span>
			<span class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-white/30 bg-black/15 px-3.5 text-white/90">
				<strong class="text-white">3 gaya</strong> sekali generate
			</span>
			<span class="inline-flex min-h-11 items-center gap-1.5 rounded-lg border border-white/30 bg-black/15 px-3.5 text-white/90">
				<strong class="text-white">Shopee-ready</strong> product list
			</span>
		</div>
	</Reveal>

	<Reveal delay={0.15} className="relative max-w-xl rounded-lg border border-white/25 bg-black/40 p-5 backdrop-blur-xl md:justify-self-end">
		<span class="mb-10 inline-flex rounded-lg bg-mint px-3 py-2 text-xs font-black">AI result ready</span>
		<h2 class="text-3xl font-black leading-tight md:text-4xl">Japandi Cozy Bedroom</h2>
		<p class="mt-3 text-white/75">12 produk cocok · estimasi Rp2,8jt · bisa checkout bertahap</p>
		<div class="mt-4 flex flex-wrap gap-2">
			<span class="rounded-lg border border-white/25 bg-black/15 px-3 py-2 text-sm text-white/90">Bed frame</span>
			<span class="rounded-lg border border-white/25 bg-black/15 px-3 py-2 text-sm text-white/90">Warm lamp</span>
			<span class="rounded-lg border border-white/25 bg-black/15 px-3 py-2 text-sm text-white/90">Rug</span>
		</div>
	</Reveal>
</section>
