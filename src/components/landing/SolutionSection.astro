---
import Reveal from '../motion/Reveal.astro';
import ComparisonSlider from '../motion/ComparisonSlider.astro';

const points = [
	'Makeover visual untuk kamar, kos, studio, dan ruang tamu.',
	'Rekomendasi produk berdasarkan style, warna, dan budget.',
	'Listing marketplace-ready untuk checkout langsung atau bertahap.',
];
---

<section class="grid items-center gap-10 bg-white px-4 py-18 sm:px-6 md:px-8 md:py-24 lg:grid-cols-[0.9fr_1.1fr] lg:px-18 xl:px-20" id="solution">
	<Reveal className="max-w-xl">
		<p class="mb-3.5 text-xs font-black uppercase tracking-[0.08em] text-coral">Solution</p>
		<h2 class="text-[clamp(2rem,9vw,4.3rem)] font-black leading-none tracking-normal">
			AI bantu desain, lalu ubah hasilnya jadi shopping list.
		</h2>
		<p class="mt-6 text-lg leading-relaxed text-muted">
			Roomly AI membaca foto ruangan, menjaga struktur utama, lalu menghasilkan makeover
			yang terasa mungkin diwujudkan. Setelah itu, sistem mencocokkan item visual dengan
			listing produk marketplace.
		</p>
		<ul class="mt-7 grid gap-3">
			{points.map((point) => (
				<li class="relative list-none pl-8 leading-relaxed text-muted before:absolute before:left-0 before:top-2 before:size-3.5 before:rounded before:bg-mint">
					{point}
				</li>
			))}
		</ul>
	</Reveal>

	<ComparisonSlider />
</section>
