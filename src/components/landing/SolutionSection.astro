---
const features = [
  ["AI Makeover", "Visualisasi ulang ruangan dari foto asli, tetap mempertahankan layout penting.", "ti-wand"],
  ["Smart Match", "AI mencocokkan style, prioritas barang, ukuran, warna, dan batas budget.", "ti-adjustments-heart"],
  ["Real Product", "Rekomendasi diarahkan ke produk nyata dari katalog dan marketplace.", "ti-armchair-2"],
  ["Easy Shopping", "Simpan item, bandingkan harga, lalu lanjut ke link belanja yang relevan.", "ti-shopping-cart"]
];
---

<section id="solusi" class="section-pad bg-[#22211f] text-paper">
  <div class="container-shell">
    <div class="reveal max-w-[760px]">
      <div class="eyebrow border-white/14 bg-white/8 text-[#ffdda0]"><i class="ti ti-sparkles"></i>Solusi</div>
      <h2 class="typeset-title mt-6 max-w-[11ch] text-paper">
        Wujudkan ruang tanpa <span class="italic text-coral">overthinking</span> cari inspirasi dan produk!
      </h2>
      <p class="typeset-lead mt-6 text-[#d7cdbf]">
        <b>Re\vibe Space</b> bukan hanya membuat gambar cantik. Setiap makeover dirancang untuk membantu kamu mengambil keputusan belanja dengan lebih percaya diri.
      </p>
    </div>
    <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {features.map(([title, body, icon], index) => (
        <article class={`reveal rounded-[22px] border border-white/10 p-5 ${index === 1 ? "bg-[#ffb22c] text-[#261600]" : "bg-white/7"}`}>
          <i class={`ti ${icon} text-3xl`}></i>
          <h3 class="typeset-card-title mt-14">{title}</h3>
          <p class={`mt-3 text-sm leading-7 tracking-[-0.01em] ${index === 1 ? "text-[#4e3000]" : "text-[#d7cdbf]"}`}>{body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
