---
type Plan = {
  name: string;
  price: string;
  desc: string;
  features: string[];
  cta: string;
};

const plans: Plan[] = [
  {
    name: "Starter",
    price: "Gratis",
    desc: "Untuk validasi ruangan pertama.",
    features: ["2 makeover credits", "3 style options", "Basic product list"],
    cta: "Coba Gratis"
  },
  {
    name: "Personal",
    price: "Rp49rb",
    desc: "Untuk makeover kamar atau kos serius.",
    features: ["20 makeover credits", "Budget-aware product matching", "Priority marketplace links"],
    cta: "Pilih Personal"
  },
  {
    name: "Partner",
    price: "Custom",
    desc: "Untuk seller, affiliate, dan marketplace campaign.",
    features: ["Product feed integration", "Materi campaign siap pakai", "Performance reporting"],
    cta: "Diskusi Partner"
  }
];
---

<section id="pricing" class="section-pad">
  <div class="container-shell">
    <div class="reveal max-w-[780px]">
      <div class="eyebrow"><i class="ti ti-ticket"></i>Pricing</div>
      <h2 class="typeset-title mt-6 max-w-[12ch]">
        Mulai gratis, naik saat butuh lebih banyak desain.
      </h2>
    </div>
    <div class="mt-10 grid gap-4 lg:grid-cols-3">
      {plans.map(({ name, price, desc, features, cta }, index) => (
        <article class={`reveal rounded-[22px] border p-6 ${index === 1 ? "border-[#ffb22c] bg-[#22211f] text-paper shadow-[0_28px_80px_rgba(0,0,0,0.2)]" : "border-black/10 bg-[#fffaf1]/76"}`}>
          <h3 class="font-display text-[2rem] font-black leading-none tracking-[-0.045em]">{name}</h3>
          <p class="mt-5 font-display text-[clamp(2.4rem,4vw,3.6rem)] font-black leading-none tracking-[-0.05em]">{price}</p>
          <p class={`mt-4 text-base leading-7 tracking-[-0.01em] ${index === 1 ? "text-[#d7cdbf]" : "text-[#675f56]"}`}>{desc}</p>
          <ul class="mt-8 space-y-3">
            {features.map((feature) => (
              <li class="flex items-center gap-3 text-[0.98rem] font-bold leading-6 tracking-[-0.01em]">
                <i class="ti ti-check text-[#ffb22c]"></i>
                {feature}
              </li>
            ))}
          </ul>
          <a href="#beta" class={`btn mt-8 w-full ${index === 1 ? "btn-primary" : "btn-secondary"}`}>{cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>
