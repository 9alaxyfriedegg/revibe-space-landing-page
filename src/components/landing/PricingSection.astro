---
import Reveal from '../motion/Reveal.astro';

const plans = [
	{
		name: 'Starter',
		price: 'Gratis',
		copy: 'Untuk validasi ruangan pertama.',
		features: ['2 makeover credits', '3 style options', 'Basic product list'],
		cta: 'Coba Gratis',
		featured: false,
	},
	{
		name: 'Personal',
		price: 'Rp49rb',
		copy: 'Untuk makeover kamar atau kos serius.',
		features: ['20 makeover credits', 'Budget-aware product matching', 'Priority marketplace links'],
		cta: 'Pilih Personal',
		featured: true,
	},
	{
		name: 'Partner',
		price: 'Custom',
		copy: 'Untuk seller, affiliate, dan marketplace campaign.',
		features: ['Product feed integration', 'Materi campaign siap pakai', 'Performance reporting'],
		cta: 'Diskusi Partner',
		featured: false,
	},
];
---

<section class="bg-white px-4 py-18 sm:px-6 md:px-8 md:py-24 lg:px-18 xl:px-20" id="pricing">
	<Reveal className="mb-10 max-w-5xl md:mb-14">
		<p class="mb-3.5 text-xs font-black uppercase tracking-[0.08em] text-coral">Pricing</p>
		<h2 class="text-[clamp(2rem,9vw,4.3rem)] font-black leading-none tracking-normal">
			Mulai dari coba gratis, naik saat sudah butuh lebih banyak desain.
		</h2>
	</Reveal>

	<div class="grid gap-4 md:grid-cols-3">
		{plans.map((plan, index) => (
			<Reveal
				delay={index * 0.08}
				className={`grid gap-5 rounded-lg border p-6 ${plan.featured ? 'border-charcoal bg-charcoal text-white' : 'border-line bg-white text-ink'}`}
			>
				<span class="text-xs font-black uppercase tracking-[0.08em] text-coral">{plan.name}</span>
				<h3 class="text-[clamp(2rem,9vw,3.4rem)] font-black leading-none">{plan.price}</h3>
				<p class={plan.featured ? 'text-white/70' : 'text-muted'}>{plan.copy}</p>
				<ul class={`grid gap-2.5 pl-5 ${plan.featured ? 'text-white/70' : 'text-muted'}`}>
					{plan.features.map((feature) => <li>{feature}</li>)}
				</ul>
				<a
					class={`inline-flex min-h-13 items-center justify-center rounded-lg px-5 font-black transition hover:-translate-y-0.5 ${plan.featured ? 'bg-coral text-white' : 'border border-line bg-white text-ink'}`}
					href="#final-cta"
				>
					{plan.cta}
				</a>
			</Reveal>
		))}
	</div>
</section>
