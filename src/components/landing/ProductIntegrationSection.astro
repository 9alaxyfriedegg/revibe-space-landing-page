---
import Reveal from '../motion/Reveal.astro';

const products = [
	{
		title: 'Compact Sofa',
		copy: 'Shopee match 94% · Rp1.650.000',
		image: 'https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=640&q=80',
		alt: 'Sofa hijau modern',
	},
	{
		title: 'Warm Table Lamp',
		copy: 'Tokopedia match 91% · Rp235.000',
		image: 'https://images.unsplash.com/photo-1507473885765-e6ed057f782c?auto=format&fit=crop&w=640&q=80',
		alt: 'Lampu meja minimalis',
	},
	{
		title: 'Soft Neutral Rug',
		copy: 'Shopee match 89% · Rp475.000',
		image: 'https://images.unsplash.com/photo-1583847268964-b28dc8f51f92?auto=format&fit=crop&w=640&q=80',
		alt: 'Karpet tekstur lembut',
	},
];
---

<section class="grid items-center gap-10 bg-white px-4 py-18 sm:px-6 md:px-8 md:py-24 lg:grid-cols-[0.9fr_1.1fr] lg:px-18 xl:px-20" id="marketplace">
	<Reveal className="max-w-xl">
		<p class="mb-3.5 text-xs font-black uppercase tracking-[0.08em] text-coral">Integrasi produk</p>
		<h2 class="text-[clamp(2rem,9vw,4.3rem)] font-black leading-none tracking-normal">
			Bukan cuma inspirasi. Langsung tahu harus beli apa.
		</h2>
		<p class="mt-6 text-lg leading-relaxed text-muted">
			Setiap hasil makeover disertai product board: item prioritas, match score, estimasi harga,
			dan link marketplace. Cocok untuk user Indonesia yang ingin belanja cepat lewat Shopee,
			Tokopedia, atau partner marketplace lain.
		</p>
		<a class="mt-8 inline-flex min-h-13 items-center justify-center rounded-lg bg-charcoal px-6 font-black text-white transition hover:-translate-y-0.5" href="#final-cta">
			Minta Akses Beta
		</a>
	</Reveal>

	<Reveal delay={0.12} className="grid gap-3.5 rounded-lg border border-line bg-paper p-4 shadow-roomly sm:p-7">
		<div class="grid gap-2 pb-2 font-black text-muted sm:flex sm:items-center sm:justify-between">
			<span>Marketplace-ready cart</span>
			<strong class="text-mint-dark">Rp2.860.000</strong>
		</div>
		{products.map((product) => (
			<article class="grid min-h-28 grid-cols-[78px_1fr] items-center gap-4 rounded-lg border border-line bg-white p-2.5 sm:grid-cols-[92px_1fr_auto]">
				<img class="size-[78px] rounded-lg object-cover sm:size-[92px]" src={product.image} alt={product.alt} />
				<div>
					<h3 class="text-lg font-black leading-tight">{product.title}</h3>
					<p class="mt-1.5 leading-relaxed text-muted">{product.copy}</p>
				</div>
				<button class="col-span-2 h-10 rounded-lg bg-mint px-4 font-black text-white sm:col-span-1" type="button">
					Lihat
				</button>
			</article>
		))}
	</Reveal>
</section>
